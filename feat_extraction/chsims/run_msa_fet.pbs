#!/bin/bash
#PBS -P chsims_msa_fet
#PBS -q parallel
#PBS -l select=1:ncpus=12:mpiprocs=12:mem=160gb
#PBS -j oe
#PBS -N chsims_msa_fet

set -euo pipefail

# ---- paths ----
PROJECT_DIR="/home/svu/e0968015/feat_extraction/chsims"
DATASET_DIR="/hpctmp/scratch/e0968015/chsims"
OUT_DIR="${DATASET_DIR}/Processed"
OUT_FILE="${OUT_DIR}/features_v2.pkl"
CONFIG="${PROJECT_DIR}/chsims_fet.json"

mkdir -p "${PROJECT_DIR}/logs"
mkdir -p "${OUT_DIR}"

cd "${PROJECT_DIR}"

# ---- live logging (stdout+stderr -> console AND log file) ----
LOG_DIR="${PROJECT_DIR}/logs"
mkdir -p "${LOG_DIR}"
RUN_LOG="${LOG_DIR}/run.${PBS_JOBID:-manual}.$(date +%Y%m%d_%H%M%S).log"

# stream both stdout+stderr to console AND to RUN_LOG (line-buffered)
exec > >(stdbuf -oL -eL tee -a "${RUN_LOG}") 2>&1

echo "[info] RUN_LOG: ${RUN_LOG}"
echo "[info] Job ID: ${PBS_JOBID:-unknown}"
echo "[info] Host: $(hostname)"
echo "[info] Project dir: ${PROJECT_DIR}"
echo "[info] Dataset dir: ${DATASET_DIR}"
echo "[info] Config: ${CONFIG}"
echo "[info] Output: ${OUT_FILE}"

module purge
module load anaconda3

unset PYTHONHOME
unset PYTHONPATH

# ---- conda ----
set +u
source activate msa-fet
set -u

echo "[info] python: $(which python)"
python -V

# quick import smoke test (fails fast if deps missing)
python -c "import MSA_FET; print('[info] MSA_FET import ok')"

# ---- keep caches off /home to avoid quota issues ----
export HF_HOME="/hpctmp/scratch/e0968015/hf_home"
export TRANSFORMERS_CACHE="${HF_HOME}/transformers"
export HF_DATASETS_CACHE="${HF_HOME}/datasets"
export TORCH_HOME="${HF_HOME}/torch"
mkdir -p "$TRANSFORMERS_CACHE" "$HF_DATASETS_CACHE" "$TORCH_HOME"

# ---- job-isolated MMSA-FET tmp/log (avoid mixing with other runs) ----
export MMSA_FET_TMP="/hpctmp/scratch/e0968015/.MMSA-FET/CHSIMS/tmp"
export MMSA_FET_LOG="/hpctmp/scratch/e0968015/.MMSA-FET/CHSIMS/log"
mkdir -p "${MMSA_FET_TMP}" "${MMSA_FET_LOG}"

echo "[info] MMSA_FET tmp_dir: ${MMSA_FET_TMP}"
echo "[info] MMSA_FET log_dir: ${MMSA_FET_LOG}"

# ---- (optional) quick sanity checks ----
python - <<'PY'
import os
DATASET_DIR = "/hpctmp/scratch/e0968015/chsims"
assert os.path.exists(os.path.join(DATASET_DIR, "label.csv")), "Missing label.csv in hpctmp dataset dir"
assert os.path.isdir(os.path.join(DATASET_DIR, "Raw")), "Missing Raw/ in hpctmp dataset dir"
print("[ok] dataset structure looks good:", DATASET_DIR)
PY

# ---- run feature extraction ----
python - <<'PY'
import os
from MSA_FET import FeatureExtractionTool

PROJECT_DIR = "/home/svu/e0968015/feat_extraction/chsims"
DATASET_DIR = "/hpctmp/scratch/e0968015/chsims"
CONFIG = os.path.join(PROJECT_DIR, "chsims_fet.json")

OUT_FILE = os.path.join(DATASET_DIR, "Processed", "features.pkl")
os.makedirs(os.path.dirname(OUT_FILE), exist_ok=True)

assert os.path.exists(os.path.join(DATASET_DIR, "label.csv")), "Missing label.csv"
assert os.path.isdir(os.path.join(DATASET_DIR, "Raw")), "Missing Raw/"

tmp_dir = "/hpctmp/scratch/e0968015/.MMSA-FET/CHSIMS/tmp"
log_dir = "/hpctmp/scratch/e0968015/.MMSA-FET/CHSIMS/log"

fet = FeatureExtractionTool(
    config=CONFIG,
    tmp_dir=tmp_dir,
    log_dir=log_dir,
    verbose=1
)

fet.run_dataset(
    dataset_dir=DATASET_DIR,
    out_file=OUT_FILE,
    num_workers=4
)

print(f"[done] Saved features to {OUT_FILE}")
PY

echo "[done] PBS job completed successfully."

