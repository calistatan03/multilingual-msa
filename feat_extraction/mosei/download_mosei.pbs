#!/bin/bash
#PBS -P download_mosei
#PBS -q serial
#PBS -l select=1:ncpus=1
#PBS -j oe
#PBS -N mosei_dl

set -euo pipefail
cd "$PBS_O_WORKDIR" || exit 1

mkdir -p logs MOSEI/Raw MOSEI/Processed

module purge || true
module load anaconda3

ENV_NAME="mosei-fet-dl"
if ! conda info --envs | awk '{print $1}' | grep -qx "$ENV_NAME"; then
  conda create -y -n "$ENV_NAME" python=3.9
fi
source activate "$ENV_NAME"

python -m pip install --upgrade pip
python -m pip install --upgrade gdown pandas tqdm

RAW_FOLDER_URL="https://drive.google.com/drive/folders/1o2pOWQg8fxJkgBJVWk9mjCrbcc1jX4eq?usp=sharing"
LABEL_FILE_URL="https://drive.google.com/file/d/17_IhQLXHqON78XX5i0h9c0ywXXpt60PX/view?usp=drive_link"

echo "[1/3] Downloading label.csv..."
if ! gdown "$LABEL_FILE_URL" -O MOSEI/label_raw.csv; then
  echo "[error] Failed to download label file (Drive permissions/throttling)."
  exit 2
fi

echo "[2/3] Reordering label columns..."
python - <<'PY'
import pandas as pd

inp = "MOSEI/label_raw.csv"
out = "MOSEI/label.csv"

df = pd.read_csv(inp)
wanted = ["video_id","clip_id","text","label","label_T","label_A","label_V","annotation","mode"]

missing = [c for c in wanted if c not in df.columns]
if missing:
    raise SystemExit(f"Missing columns {missing}. Found: {list(df.columns)}")

df = df[wanted]
df.to_csv(out, index=False)
print("[done] wrote", out)
PY
rm -f MOSEI/label_raw.csv

echo "[3/3] Downloading raw clips folder..."
TMP_DIR="MOSEI/_raw_tmp"
rm -rf "$TMP_DIR"
mkdir -p "$TMP_DIR"

if ! gdown --folder "$RAW_FOLDER_URL" -O "$TMP_DIR"; then
  echo "[error] Failed to download raw folder (Drive permissions/throttling)."
  exit 3
fi

# If gdown created an extra wrapper folder, descend until we see multiple video_id folders
SRC="$TMP_DIR"
while [ "$(find "$SRC" -mindepth 1 -maxdepth 1 -type d | wc -l)" -eq 1 ] && \
      [ "$(find "$SRC" -mindepth 1 -maxdepth 1 -type f | wc -l)" -eq 0 ]; do
  SRC="$(find "$SRC" -mindepth 1 -maxdepth 1 -type d | head -n 1)"
done

echo "[info] Moving video_id folders into MOSEI/Raw (expects <video_id>/<clip_id>.mp4)..."
shopt -s nullglob
for vid_dir in "$SRC"/*; do
  if [ -d "$vid_dir" ]; then
    vid="$(basename "$vid_dir")"
    if [ -d "MOSEI/Raw/$vid" ]; then
      echo "[warn] MOSEI/Raw/$vid exists; merging..."
      rsync -a "$vid_dir"/ "MOSEI/Raw/$vid"/ || true
    else
      mv "$vid_dir" "MOSEI/Raw/$vid"
    fi
  fi
done
shopt -u nullglob

rm -rf "$TMP_DIR"

echo "[done] Final structure checks:"
test -f MOSEI/label.csv && echo "OK: MOSEI/label.csv"
test -d MOSEI/Raw && echo "OK: MOSEI/Raw/"
echo "Label header:"
head -n 1 MOSEI/label.csv || true
echo "Sample video_id dirs:"
ls MOSEI/Raw | head -n 5 || true

exit $?

