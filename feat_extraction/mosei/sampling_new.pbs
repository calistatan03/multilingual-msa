#!/bin/bash
#PBS -P mosei_sampling
#PBS -q parallel
#PBS -l select=1:ncpus=12:mpiprocs=12:mem=80gb
#PBS -j oe
#PBS -N mosei_sampling

cd "$PBS_O_WORKDIR" || exit 1

mkdir -p logs
LOGFILE="logs/mosei_sample_disjoint_${PBS_JOBID}.log"
exec > "$LOGFILE" 2>&1

echo "JobID: $PBS_JOBID"
echo "Host: $(hostname)"
echo "Start: $(date)"
echo "Workdir: $PWD"
echo

module purge || true
module load anaconda3
echo "python is: $(which python)"
python -V

# ---- EDIT IF NEEDED ----
INFILE="data/label.csv"
OUTDIR="data"
OUTFILE="${OUTDIR}/label_sampled.csv"
# ------------------------

TRAIN_N=2722
VALID_N=647
TEST_N=1034

LOW=-2.0
HIGH=2.0

# optional: increase unique videos by limiting utterances per video
CAP_TRAIN=30
CAP_VALID=30
CAP_TEST=30

mkdir -p "$OUTDIR"
python3 - <<'PY'
# -*- coding: utf-8 -*-
import csv, random, os
from collections import defaultdict, Counter

INFILE  = "/hpctmp/scratch/e0968015/mosei/label_original.csv"
OUTFILE = "data/label_sampled.csv"

SEED = 42
random.seed(SEED)

VIDEO_COL = "video_id"
MODE_COL  = "mode"
LABEL_COL = "label"

# utterance targets
UTT_TARGET = {"train": 2722, "valid": 647, "test": 1034}

# your requested unique-video quotas (pick one set and keep it fixed)
VID_QUOTA = {"train": 105, "valid": 40, "test": 50}   # e.g. valid in [20,22], test in [34,35]
# If you prefer: {"train":90, "valid":20, "test":34}

LOW, HIGH = -2.0, 2.0
MAX_TRIES = 5000  # random attempts per split to find quota videos with enough utterances

# mode -> video -> rows
by_mode_video = defaultdict(lambda: defaultdict(list))
raw = Counter()
kept = Counter()

with open(INFILE, "r", encoding="utf-8") as f:
    reader = csv.DictReader(f)
    if not reader.fieldnames:
        raise SystemExit("Input CSV has no header / is empty: %s" % INFILE)

    header = list(reader.fieldnames)  # preserve input column order exactly

    need = [VIDEO_COL, MODE_COL, LABEL_COL]
    missing = [c for c in need if c not in header]
    if missing:
        raise SystemExit("Missing columns %s. Found: %s" % (missing, header))

    for row in reader:
        mode = (row.get(MODE_COL, "") or "").strip()
        if mode not in UTT_TARGET:
            continue

        vid = (row.get(VIDEO_COL, "") or "").strip()
        if not vid:
            continue

        try:
            y = float(row[LABEL_COL])
        except Exception:
            continue

        raw[mode] += 1
        if not (LOW <= y <= HIGH):
            continue

        by_mode_video[mode][vid].append(row)
        kept[mode] += 1

print("=== After label filter [%s, %s] ===" % (LOW, HIGH))
for m in ["train", "valid", "test"]:
    print("%-5s: raw %6d | kept %6d | unique videos %4d" % (m, raw[m], kept[m], len(by_mode_video[m])))
print("")

# Optional sanity: check video overlap across splits in the filtered pool
train_pool = set(by_mode_video["train"].keys())
valid_pool = set(by_mode_video["valid"].keys())
test_pool  = set(by_mode_video["test"].keys())
print("=== Video overlaps in filtered pool (should be 0 for MOSEI) ===")
print("train & valid:", len(train_pool & valid_pool))
print("train & test :", len(train_pool & test_pool))
print("valid & test :", len(valid_pool & test_pool))
print("")

def choose_quota_videos(mode, quota, target):
    """Pick exactly `quota` videos whose total utterances >= target."""
    vids = list(by_mode_video[mode].keys())
    if len(vids) < quota:
        raise SystemExit("Not enough videos in %s after filtering: have %d, need %d" % (mode, len(vids), quota))

    counts = {v: len(by_mode_video[mode][v]) for v in vids}

    # Fast fallback: top-quota by count will maximise total coverage
    top_by_count = sorted(vids, key=lambda v: counts[v], reverse=True)[:quota]
    top_total = sum(counts[v] for v in top_by_count)

    # Try random subsets first (keeps it less “biased” towards long videos)
    for _ in range(MAX_TRIES):
        chosen = random.sample(vids, quota)
        total = sum(counts[v] for v in chosen)
        if total >= target:
            return chosen, total, "random"

    # If random never succeeds, use best-coverage deterministic set
    if top_total >= target:
        return top_by_count, top_total, "top_by_count"

    # If even top-by-count cannot reach target, it's impossible with this quota
    raise SystemExit(
        "Impossible for %s: even best %d videos only give %d utterances (< target %d). "
        "Increase quota or relax target/filter."
        % (mode, quota, top_total, target)
    )

def round_robin_sample(mode, chosen_vids, target_n):
    # Shuffle rows within each chosen video
    for v in chosen_vids:
        random.shuffle(by_mode_video[mode][v])

    selected = []
    used_idx = Counter()
    active = list(chosen_vids)
    i = 0

    while len(selected) < target_n and active:
        v = active[i % len(active)]
        idx = used_idx[v]
        rows = by_mode_video[mode][v]
        if idx >= len(rows):
            # this video is exhausted
            active.remove(v)
            continue
        selected.append(rows[idx])
        used_idx[v] += 1
        i += 1

    if len(selected) < target_n:
        raise SystemExit("Shortfall in %s: got %d, need %d. (Quota videos exhausted)" % (mode, len(selected), target_n))
    return selected

selected_videos = {}
for m in ["train", "valid", "test"]:
    chosen, total_avail, how = choose_quota_videos(m, VID_QUOTA[m], UTT_TARGET[m])
    selected_videos[m] = chosen
    print("%s: chose %d videos (quota %d) | utterances available %d | method=%s" %
          (m, len(chosen), VID_QUOTA[m], total_avail, how))
print("")

train_rows = round_robin_sample("train", selected_videos["train"], UTT_TARGET["train"])
valid_rows = round_robin_sample("valid", selected_videos["valid"], UTT_TARGET["valid"])
test_rows  = round_robin_sample("test",  selected_videos["test"],  UTT_TARGET["test"])

def uniq_vid(rows):
    return len(set((r.get(VIDEO_COL) or "").strip() for r in rows))

print("=== Final sample stats ===")
print("train: utterances %4d | unique videos %3d (target %d)" % (len(train_rows), uniq_vid(train_rows), VID_QUOTA["train"]))
print("valid: utterances %4d | unique videos %3d (target %d)" % (len(valid_rows), uniq_vid(valid_rows), VID_QUOTA["valid"]))
print("test : utterances %4d | unique videos %3d (target %d)" % (len(test_rows),  uniq_vid(test_rows),  VID_QUOTA["test"]))
print("")

selected_all = train_rows + valid_rows + test_rows

outdir = os.path.dirname(OUTFILE)
if outdir and not os.path.exists(outdir):
    os.makedirs(outdir)

with open(OUTFILE, "w", encoding="utf-8") as fo:
    w = csv.DictWriter(fo, fieldnames=header, lineterminator="\n")
    w.writeheader()
    for r in selected_all:
        w.writerow({k: r.get(k, "") for k in header})

print("Wrote:", OUTFILE)
print("Total rows:", len(selected_all))
PY

